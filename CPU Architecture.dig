    <visualElement>
      <elementName>Text</elementName>
      <elementAttributes>
        <entry>
          <string>Description</string>
          <string>Register Mode(Type of Op = 00) = 2bit(Type of op) + 2bit(Op) + 2bit(Reg 1) + 2bit(Reg 2) + 8bit(Don&apos;t Care)
Immediate Mode(Type of Op = 01) = 2bit(Type of op) + 2bit(Op) + 2bit(Reg 1) + 3bit(Imm Value) + 7bit(Don&apos;t Care)
Jump Mode(Type of Op = 10) = 2bit(Type of op) + 2bit(Op) + 4bit(Address) + 8bit(Don&apos;t Care)
OR (Op = 00), Add (Op = 01), SHR (Op = 10)
JMP (Op = 00), JL (Op = 01)

	JL START 1001001000000000 ZF=0,SF=1
	OR R1,5 0100011010000000
START:	OR R1,3 0100010110000000
JMP-TO: 	ADD R1,R1 0001010100000000
	JMP JMP-TO 1000001100000000</string>
        </entry>
      </elementAttributes>
      <pos x="240" y="-280"/>
    </visualElement>
